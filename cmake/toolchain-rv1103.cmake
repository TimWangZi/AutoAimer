set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(LUCKFOX_SDK_PATH "" CACHE PATH "Path to the Luckfox Pico SDK")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LUCKFOX_SDK_PATH)
if(NOT LUCKFOX_SDK_PATH)
    message(FATAL_ERROR "Specify -DLUCKFOX_SDK_PATH=/path/to/luckfox-pico")
endif()
set(triple arm-rockchip830-linux-uclibcgnueabihf)
set(toolchain "${LUCKFOX_SDK_PATH}/tools/linux/toolchain/${triple}")
set(CMAKE_CXX_COMPILER "${toolchain}/bin/${triple}-g++")
set(CMAKE_FIND_ROOT_PATH "${toolchain}/${triple}/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
